NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOCAL_DATA_FILE=data/local-store.json
# Set this to the AWS region where SNS SMS is enabled.
# AWS credentials are resolved using the AWS SDK default credential chain.
# AWS_REGION=eu-west-1
# Optional: require this secret before allowing new accounts to register.
# Use at least 32 random characters for public deployments.
# REGISTRATION_INVITE_CODE=replace-with-a-long-random-invitation-code
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
